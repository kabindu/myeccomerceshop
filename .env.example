####################################################################
# Copy this file to .env and fill in your own values.
#
#   cp .env.example .env
#
# .env is git-ignored, so your real values never get committed.
# Store branding (name, logo, currency, contact details) is NOT here
# — that lives in store.config.js.
####################################################################

# ------------------------------------------------------------------
# DATABASE (required)
# ------------------------------------------------------------------
# Any PostgreSQL database: local, Neon, Supabase, Railway, RDS, ...
# Tables are created automatically the first time the server starts.
DATABASE_URL=postgres://user:password@localhost:5432/mystore

# Instead of DATABASE_URL you can use these individually:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=mystore
# PGUSER=postgres
# PGPASSWORD=
# PGSSLMODE=require

# ------------------------------------------------------------------
# ADMIN LOGIN (required)
# ------------------------------------------------------------------
# Your own username and password for /admin. There is no default —
# until you set these, the admin dashboard cannot be signed into.
# Use a long, random password: it also signs the admin session cookie.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ------------------------------------------------------------------
# SESSIONS (required in production)
# ------------------------------------------------------------------
# Signs customer and seller login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left blank the server generates a throwaway secret at startup,
# which means everyone is signed out every time it restarts.
SESSION_SECRET=

# ------------------------------------------------------------------
# SELLER VERIFICATION (optional)
# ------------------------------------------------------------------
# Both are optional and independent. With neither set, sellers still
# register with an email and password and you still approve them by
# hand in /admin - you just do not get Google sign-in or email codes.

# --- Sign in with Google ---
# console.cloud.google.com > APIs & Services > Credentials >
#   Create credentials > OAuth client ID > Web application
# Add this exact URL under "Authorised redirect URIs":
#   http://localhost:3000/api/seller/auth/google/callback   (local)
#   https://your-domain.com/api/seller/auth/google/callback (live)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the server cannot work out its own public URL, e.g.
# behind a proxy that rewrites the host. Must match Google exactly.
GOOGLE_REDIRECT_URI=

# --- Email, for the 6-digit verification codes ---
# Any SMTP provider: Gmail, Mailgun, SendGrid, Brevo, Resend, your host.
# Leave blank while developing and codes are printed to the server
# console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
# Leave blank to infer from the port (465 = implicit TLS, otherwise STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# What sellers see in the From line, e.g. "My Store <no-reply@example.com>"
MAIL_FROM=

# ------------------------------------------------------------------
# OPTIONAL
# ------------------------------------------------------------------
# Port to listen on (default 3000)
# PORT=3000

# Store product images in Vercel Blob instead of on disk. Required on
# serverless hosts, where the filesystem is wiped between requests.
# BLOB_READ_WRITE_TOKEN=
